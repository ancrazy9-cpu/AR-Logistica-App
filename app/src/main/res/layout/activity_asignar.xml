<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="#F5F9FF">


    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">


        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="AR LOGÍSTICA"

            android:textColor="#0B4F9C"

            android:textSize="26sp"

            android:textStyle="bold"/>


        <TextView

            android:id="@+id/txtSolicitudAsignar"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Solicitud"

            android:textSize="18sp"

            android:textStyle="bold"/>


        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Seleccione vehículo"

            android:textSize="16sp"

            android:textStyle="bold"/>


        <Spinner

            android:id="@+id/spinnerVehiculo"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginTop="10dp"/>



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Seleccione conductor"

            android:textSize="16sp"

            android:textStyle="bold"/>


        <Spinner

            android:id="@+id/spinnerConductor"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginTop="10dp"/>



        <Button

            android:id="@+id/btnConfirmarAsignacion"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginTop="35dp"

            android:text="Confirmar asignación"

            android:textAllCaps="false"/>


        <Button

            android:id="@+id/btnCancelarAsignacion"

            android:layout_width="match_parent"

            android:layout_height="55dp"

            android:layout_marginTop="10dp"

            android:text="Cancelar"

            android:textAllCaps="false"/>


    </LinearLayout>


</ScrollView>